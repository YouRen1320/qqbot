# ============ NoneBot 基础配置 ============
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO

# OneBot V11 鉴权 token —— NapCat 反向连接时必须带相同的 token
# 随便填一串，但要和 napcat/config/onebot11_<你的QQ>.json 里的 token 一致
ONEBOT_ACCESS_TOKEN=your_random_token_here

# ============ Bot 身份 ============
# 主名称（显示在备忘录卡片、状态消息等处）
BOT_NAME=墨七七
# 别名（逗号分隔），群友 @ 或提到任何一个都会触发
BOT_ALIASES=七七,miku

# ============ 业务配置 ============
# 允许 bot 工作的群号（逗号分隔，留空=不在任何群响应）
# 上线初期建议只填一个测试群
ENABLED_GROUPS=

# 私聊管理员 QQ（接收 /status /pause /resume /set /say 命令）
# 留空则不启用管理命令
ADMIN_QQ=

# SQLite 历史落盘位置（容器内路径；通过 ./data 挂出）
QQBOT_DB_PATH=/app/data/qqbot.db

# ============ AI 主模型（GPT / DeepSeek / 通义 / 任何 OpenAI 兼容 API） ============
# litellm 统一接入，支持任何 OpenAI 兼容提供商
# 闲聊走 PRIMARY_MODEL，复杂问题走 PRIMARY_MODEL_PRO
AI_PRIMARY_API_KEY=sk-your_primary_key_here
AI_PRIMARY_BASE_URL=https://api.openai.com/v1
AI_PRIMARY_MODEL=gpt-4o
AI_PRIMARY_MODEL_PRO=gpt-4o

# litellm provider 前缀（默认 openai，改 deepseek / anthropic / gemini 等按需调整）
# AI_PROVIDER_PREFIX=openai

# ============ AI 备用模型（主模型挂了自动切） ============
# 可以留空，留空则主模型失败时无 fallback
AI_FALLBACK_API_KEY=
AI_FALLBACK_BASE_URL=
AI_FALLBACK_MODEL=
AI_FALLBACK_API_KEY_PRO=
AI_FALLBACK_BASE_URL_PRO=
AI_FALLBACK_MODEL_PRO=

# ============ 看图模型（多模态） ============
# 需要支持 vision 的模型（gpt-4o / gemini / qwen-vl 等）
# 留空则复用主模型配置
AI_MODEL_OMNI=gpt-4o
AI_OMNI_API_KEY=
AI_OMNI_BASE_URL=

# ============ 图片生成（可选） ============
# 支持 DALL-E 3 / gpt-image-2 等 OpenAI 兼容图片 API
# 留空则生图功能不可用
IMAGE_GEN_API_KEY=
IMAGE_GEN_BASE_URL=https://api.openai.com
IMAGE_GEN_MODEL=dall-e-3

# ============ 联网搜索（可选） ============
# @bot 问时事时自动联网搜索再回答
# 支持 tavily（默认）/ serper / brave，需要对应 API key
# 留空则联网搜索不可用，bot 会用"没关注"之类的话术绕过
# SEARCH_PROVIDER=tavily
# SEARCH_API_KEY=

# ============ 视频解析（可选） ============
# yt-dlp cookies 文件路径（抖音/快手等需要 cookies 才能解析）
# 从浏览器导出 Netscape 格式 cookies.txt 放到 data/ 目录
# YT_DLP_COOKIES=/app/data/cookies.txt

# 抖音解析 API 地址（docker-compose 里的 douyin-api 服务）
# 默认走 compose 内部 DNS，通常不需要改
# DOUYIN_API=http://douyin-api

# 视频中转服务地址（bot 先下载视频再通过此地址让 NapCat 拉取）
# 默认自动检测，通常不需要改
# FILE_RELAY_BASE_URL=http://nonebot:8080

# ============ AI 自维护（可选，Claude 自动修 bug） ============
# 需要 Anthropic API key；留空则禁用自维护功能
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# 自维护思考和输出 token 预算（一般不需要改）
# MAINTAIN_THINKING_BUDGET=8000
# MAINTAIN_MAX_TOKENS=16000

# ============ 旧版兼容（可忽略） ============
# 以下变量被部分模块直接引用，填了上面的就够了
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_MODEL_PRO=
AI_API_KEY_PRO=
AI_BASE_URL_PRO=
